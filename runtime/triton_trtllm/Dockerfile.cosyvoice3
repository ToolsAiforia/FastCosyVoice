FROM soar97/triton-cosyvoice:25.06

RUN pip install --no-cache-dir cython && \
    pip install --no-cache-dir --no-build-isolation --no-deps matcha-tts && \
    pip install --no-cache-dir "s3tokenizer>=0.3" x-transformers && \
    pip install --no-cache-dir --no-deps \
      "git+https://github.com/ToolsAiforia/FastCosyVoice@round-9-stable"

# WORKDIR /workspace gets overwritten by runpod
WORKDIR /workdir

ADD ./Fun-CosyVoice3-0.5B-2512 /workdir/Fun-CosyVoice3-0.5B-2512
ADD ./cosyvoice3_llm /workdir/cosyvoice3_llm
ADD ./model_repo_cosyvoice3 /model_repo

COPY entrypoint_cosyvoice3.sh /workdir/entrypoint.sh
COPY scripts/convert_checkpoint.py /workdir/scripts/convert_checkpoint.py
COPY scripts/fill_template.py /workdir/scripts/fill_template.py
COPY export_hift_trt.py /workdir/scripts/export_hift_trt.py
COPY prebuild_trt_plans.py /workdir/scripts/prebuild_trt_plans.py
COPY generate_spk2info.py /workdir/scripts/generate_spk2info.py
COPY warmup.py /workdir/scripts/warmup.py
# Runtime LLM options (prefix cache + cuda graph + chunked prefill).
# entrypoint passes this via --extra_llm_api_options; without it the
# server ignores the yaml and runs on defaults.
COPY trtllm_runtime_options.yaml /workdir/trtllm_runtime_options.yaml
# Default speaker reference (neutral_2 — smooth, business tone).
# Entrypoint auto-generates spk2info.pt from this on first start.
COPY default_speaker_neutral_2.wav /workdir/default_speaker.wav
COPY default_speaker_neutral_2.txt /workdir/default_speaker.txt
RUN chmod +x /workdir/entrypoint.sh

EXPOSE 8000 8001 8002
ENTRYPOINT ["/workdir/entrypoint.sh"]
