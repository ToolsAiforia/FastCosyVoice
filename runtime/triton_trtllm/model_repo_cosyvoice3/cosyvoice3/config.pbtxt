name: "cosyvoice3"
backend: "python"
max_batch_size: 1
dynamic_batching {
    max_queue_delay_microseconds: 0
}
model_transaction_policy {
  decoupled: True
}
parameters [
  {
   key: "llm_tokenizer_dir",
   value: {string_value:"/workspace/CosyVoice/runtime/triton_trtllm/hf_cosyvoice3_llm"}
  },
  {
   key: "model_dir",
   value: {string_value:"/workspace/CosyVoice/runtime/triton_trtllm/Fun-CosyVoice3-0.5B-2512"}
  },
  {
   key: "llm_api_base",
   value: {string_value:"http://localhost:8000/v1/chat/completions"}
  },
  {
   # Voice-chat streaming preset: WAIT=0 → coordinator чисто оппортунистический,
   # никакого TTFA overhead'а на критичной для conversation latency.
   # Batching engages только когда два push'а случайно совпали в очереди.
   key: "t2w_dispatch_wait_ms",
   value: {string_value:"0"}
  },
  {
   key: "voc_dispatch_wait_ms",
   value: {string_value:"0"}
  }
]

input [
  {
    name: "reference_wav"
    data_type: TYPE_FP32
    dims: [-1]
    optional: true
  },
  {
    name: "reference_wav_len"
    data_type: TYPE_INT32
    dims: [1]
    optional: true
  },
  {
    name: "reference_text"
    data_type: TYPE_STRING
    dims: [1]
    optional: true
  },
  {
    name: "speaker_name"
    data_type: TYPE_STRING
    dims: [1]
    optional: true
  },
  {
    # Optional per-request instruction override. When provided, replaces the
    # baked instruction in the cached/zero-shot reference_text (formatted as
    # "{instruction}<|endofprompt|>{transcription}{target_text}" for LLM).
    # Example values: "Speak with excitement", "Whisper softly", "Read as news".
    name: "instruction"
    data_type: TYPE_STRING
    dims: [1]
    optional: true
  },
  {
    name: "target_text"
    data_type: TYPE_STRING
    dims: [1]
  }
]
output [
  {
    name: "waveform"
    data_type: TYPE_FP32
    dims: [ -1 ]
  }
]

instance_group [
  {
    # Production win baseline: count=2. Меньше process overhead, плотнее
    # event-loop'ы, лучше TTFA. Empirically validated лучше count=4 на N=4/8.
    count: 2
    kind: KIND_CPU
  }
]