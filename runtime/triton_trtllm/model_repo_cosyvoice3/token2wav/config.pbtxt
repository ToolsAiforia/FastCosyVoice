name: "token2wav"
backend: "python"
max_batch_size: 8

# Tier-4: NO Triton dynamic_batching. BLS coordinator batches in-process
# opportunistically (no queue_delay). Triton just routes single batched req
# to one instance — straight execute().
dynamic_batching {
    max_queue_delay_microseconds: 0
    preferred_batch_size: [ 2, 4, 8 ]
}

parameters [
  {
   key: "model_dir",
   value: {string_value:"/workspace/CosyVoice/runtime/triton_trtllm/Fun-CosyVoice3-0.5B-2512"}
  }
]

input [
  {
    name: "target_speech_tokens"
    data_type: TYPE_INT32
    dims: [-1]
  },
  {
    name: "prompt_speech_tokens"
    data_type: TYPE_INT32
    dims: [-1]
    optional: true
  },
  {
    name: "prompt_speech_feat"
    data_type: TYPE_FP16
    dims: [-1, 80]
    optional: true
  },
  {
    name: "prompt_spk_embedding"
    data_type: TYPE_FP16
    dims: [-1]
    optional: true
  },
  {
    name: "token_offset"
    data_type: TYPE_INT32
    dims: [ 1 ]
    reshape: { shape: [ ] }
    optional: true
  },
  {
    name: "finalize"
    data_type: TYPE_BOOL
    dims: [ 1 ]
    reshape: { shape: [ ] }
    optional: true
  }
]
output [
  {
    name: "mel"
    data_type: TYPE_FP32
    dims: [ 80, -1 ]
  }
]

instance_group [
  {
    count: 4
    kind: KIND_GPU
    gpus: [ 0 ]
  }
]

# Tier-3 warmup: TRT context cold start ~1200ms (N=1 p99 baseline). After warmup,
# all kernel shapes for typical streaming chunk are JIT-cached → cold tail eliminated.
# Synthetic input shape matches first streaming chunk: 9 target tokens + 25 prompt + 50 mel.
model_warmup [
  {
    name: "warmup_streaming_chunk0"
    count: 1
    batch_size: 1
    inputs {
      key: "target_speech_tokens"
      value: { data_type: TYPE_INT32, dims: [9], zero_data: true }
    }
    inputs {
      key: "prompt_speech_tokens"
      value: { data_type: TYPE_INT32, dims: [25], zero_data: true }
    }
    inputs {
      key: "prompt_speech_feat"
      value: { data_type: TYPE_FP16, dims: [50, 80], zero_data: true }
    }
    inputs {
      key: "prompt_spk_embedding"
      value: { data_type: TYPE_FP16, dims: [192], zero_data: true }
    }
    inputs {
      key: "token_offset"
      value: { data_type: TYPE_INT32, dims: [1], zero_data: true }
    }
    inputs {
      key: "finalize"
      value: { data_type: TYPE_BOOL, dims: [1], zero_data: true }
    }
  }
]